# Secret used to sign session JWTs. Generate a long random string for production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# Postgres connection string. For Neon (recommended, works great with Netlify),
# grab this from your Neon project dashboard or Netlify's built-in "Netlify DB"
# integration (Team > Extensions > Neon). Example format:
#   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
